{
  "expo": {
    "name": "Anında Teklif",
    "slug": "aninda-teklif",
    "owner": "cagdsmetin",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "anindateklif",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d8d615f-66fb-42ec-b916-2ef957a4ac28"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.anindateklif.app",
      "infoPlist": {
        "NSPhotoLibraryUsageDescription": "Şirket logosu seçmek için galeri erişimi"
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/adaptive-icon.png",
        "backgroundColor": "#000000"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.anindateklif.app",
      "versionCode": 1
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/splash-image.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#000000"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "eas": {
        "projectId": "7d8d615f-66fb-42ec-b916-2ef957a4ac28"
      }
    }
  }
}
